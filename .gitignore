  { title: 'The Pianist', year: 2002, genre: 'Drama', duration: '2h 30m', description: 'A sobrevivência de um músico judeu durante o Holocausto.', poster: 'https://images.unsplash.com/photo-1516280440614-37939bbacd81?auto=format&fit=crop&w=900&q=80' },
  { title: 'A Beautiful Mind', year: 2001, genre: 'Biografia', duration: '2h 15m', description: 'A historia de John Nash, um matemático brilhante e atormentado.', poster: 'https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?auto=format&fit=crop&w=900&q=80' },
  { title: 'The Pursuit of Happyness', year: 2006, genre: 'Drama', duration: '1h 57m', description: 'Uma jornada de superação em busca de uma vida melhor.', poster: 'https://images.unsplash.com/photo-1515879218367-8466d910aaa4?auto=format&fit=crop&w=900&q=80' },
  { title: 'The King\'s Speech', year: 2010, genre: 'Biografia', duration: '1h 58m', description: 'Uma historia de coragem e superação de um rei em dificuldades.', poster: 'https://images.unsplash.com/photo-1536440136628-849c177e76a1?auto=format&fit=crop&w=900&q=80' },
  { title: 'Schindler\'s List', year: 1993, genre: 'Drama', duration: '3h 15m', description: 'Um empresário alemão salva milhares de judeus durante o Holocausto.', poster: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?auto=format&fit=crop&w=900&q=80' },
  { title: 'The Green Knight', year: 2021, genre: 'Fantasia', duration: '2h 10m', description: 'Um cavaleiro busca o desafio de uma cruzada misteriosa.', poster: 'https://images.unsplash.com/photo-1497032628192-86f99bcd76bc?auto=format&fit=crop&w=900&q=80' },
  { title: 'The Batman', year: 2022, genre: 'Suspense', duration: '2h 56m', description: 'Quando a cidade mergulha em caos, Bruce Wayne se torna o vigilante da noite.', poster: 'https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?auto=format&fit=crop&w=900&q=80' },
  { title: 'Madame Web', year: 2024, genre: 'Ação', duration: '1h 56m', description: 'Uma mulher com visão para o futuro enfrenta destinos ameaçadores.', poster: 'https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=900&q=80' },
  { title: 'Dune: Part Two', year: 2024, genre: 'Sci-Fi', duration: '2h 46m', description: 'Paul Atreides precisa sobreviver ao deserto e ao poder da casa imperial.', poster: 'https://images.unsplash.com/photo-1516280440614-37939bbacd81?auto=format&fit=crop&w=900&q=80' },
  { title: 'The Batman', year: 2022, genre: 'Ação', duration: '2h 56m', description: 'Batman persegue criminosos em uma Gotham sombria e perigosa.', poster: 'https://images.unsplash.com/photo-1524985069026-dd778a71c7b4?auto=format&fit=crop&w=900&q=80' },
];

const catalog = [];

for (let i = 0; i < 13000; i += 1) {
  const source = realMovies[i % realMovies.length];
  const title = source.title;
  catalog.push({
    id: i + 1,
    title,
    year: source.year,
    genre: source.genre,
    duration: source.duration,
    description: source.description,
    poster: source.poster,
  });
}

export const movies = catalog;
